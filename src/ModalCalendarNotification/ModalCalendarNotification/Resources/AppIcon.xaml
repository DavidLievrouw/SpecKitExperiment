<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <DrawingImage x:Key="AppIconDrawing">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- Calendar background (white) with border -->
        <GeometryDrawing Brush="#FFFFFFFF">
          <GeometryDrawing.Pen>
            <Pen Brush="#FF1F2937" Thickness="0.5" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M2,2 L30,2 L30,30 L2,30 Z M2,8 L30,8" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Calendar header (blue) -->
        <GeometryDrawing Brush="#FF3B82F6">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="2,2 28,6" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Calendar grid lines -->
        <!-- Horizontal lines for rows -->
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#FFE5E7EB" Thickness="0.5" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M2,12 L30,12 M2,16 L30,16 M2,20 L30,20 M2,24 L30,24" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Vertical lines for columns -->
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#FFE5E7EB" Thickness="0.5" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <PathGeometry Figures="M8,8 L8,30 M14,8 L14,30 M20,8 L20,30 M26,8 L26,30" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Highlighted date (23 - today in orange) -->
        <GeometryDrawing Brush="#FFFFB822">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="13,17" RadiusX="1.8" RadiusY="1.8" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <!-- Colorful accent marks on different days -->
        <GeometryDrawing Brush="#FF10B981">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="5.2,10.5" RadiusX="0.4" RadiusY="0.4" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <GeometryDrawing Brush="#FFF59E0B">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="28.2,10.5" RadiusX="0.4" RadiusY="0.4" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <GeometryDrawing Brush="#FFC0504D">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="5.2,28" RadiusX="0.4" RadiusY="0.4" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>

        <GeometryDrawing Brush="#FF8B5CF6">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="28.2,28" RadiusX="0.4" RadiusY="0.4" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>
