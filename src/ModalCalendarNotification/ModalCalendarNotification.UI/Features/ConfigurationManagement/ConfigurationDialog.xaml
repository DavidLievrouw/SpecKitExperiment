<Window
  x:Class="ModalCalendarNotification.UI.Features.ConfigurationManagement.ConfigurationDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Configuration"
  Width="560"
  Height="500"
  WindowStartupLocation="CenterOwner"
  Loaded="Window_Loaded"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Sync Status Indicator -->
    <Border Grid.Row="0" Padding="8" Margin="0,0,0,12" CornerRadius="4">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="#E8F5E9" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SyncStatus.IsConnected}" Value="False">
              <Setter Property="Background" Value="#FFEBEE" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <TextBlock
          Text="●"
          FontSize="14"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
        >
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="#2E7D32" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SyncStatus.IsConnected}" Value="False">
                  <Setter Property="Foreground" Value="#C62828" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <StackPanel VerticalAlignment="Center">
          <TextBlock
            Text="Connection Status: "
            FontSize="11"
            FontWeight="Bold"
          />
          <TextBlock FontSize="10">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="Connected - Last sync: {0}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SyncStatus.IsConnected}" Value="False">
                    <Setter Property="Text" Value="Disconnected - Using cached events" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem Header="Provider">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Configured Calendar Providers" FontWeight="SemiBold" />

          <DataGrid
            Grid.Row="1"
            Margin="0,8,0,12"
            ItemsSource="{Binding ConfiguredProviders}"
            AutoGenerateColumns="False"
            IsReadOnly="False"
            SelectionMode="Single"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
          >
            <DataGrid.Columns>
              <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="120" IsReadOnly="True" />
              <DataGridTextColumn Header="Account Label" Binding="{Binding AccountLabel}" Width="*" IsReadOnly="True" />
              <DataGridTemplateColumn Header="Actions" Width="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                      <Button
                        Content="Select"
                        Padding="8,4"
                        Margin="0,0,5,0"
                        Command="{Binding DataContext.SelectCalendarsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                      />
                      <Button
                        Content="Remove"
                        Padding="8,4"
                        Command="{Binding DataContext.RemoveProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                      />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <Button
            Grid.Row="3"
            Width="150"
            Content="Add Calendar Provider"
            HorizontalAlignment="Left"
            Command="{Binding AddProviderCommand}"
          />
        </Grid>
      </TabItem>

      <TabItem Header="Notification">
        <StackPanel Margin="12">
          <TextBlock Text="Lead Time (minutes)" FontWeight="SemiBold" />
          <TextBox Margin="0,8,0,12" Text="{Binding NotificationLeadTimeMinutes}" />
          <TextBlock Text="Auto Dismiss Timeout (minutes after event start)" FontWeight="SemiBold" />
          <TextBox Margin="0,8,0,0" Text="{Binding AutoDismissTimeoutSeconds}" />
          <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="Gray" Text="Notifications that remain untouched will automatically close after this duration." TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Dismissed Events">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
            Text="Event titles for which notifications have been dismissed. Select a title and click Restore to re-enable notifications."
            TextWrapping="Wrap"
            Margin="0,0,0,8"
          />

          <ListBox
            Grid.Row="1"
            ItemsSource="{Binding DismissedEventTitles}"
            SelectedItem="{Binding SelectedDismissedTitle}"
            Margin="0,0,0,12"
          />

          <Button
            Grid.Row="2"
            Width="90"
            HorizontalAlignment="Left"
            Content="Restore"
            Command="{Binding RestoreDismissedTitleCommand}"
          />
        </Grid>
      </TabItem>

      <TabItem Header="About">
        <StackPanel Margin="12">
          <TextBlock Text="Modal Calendar Notification" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Margin="0,8,0,0" Text="Version" FontWeight="SemiBold" />
          <TextBlock Margin="0,4,0,0" Text="{Binding ApplicationVersion}" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Width="90" Margin="0,0,8,0" Content="Load" Command="{Binding LoadCommand}" />
      <Button Width="90" Content="Save" Command="{Binding SaveCommand}" />
    </StackPanel>
  </Grid>
</Window>
