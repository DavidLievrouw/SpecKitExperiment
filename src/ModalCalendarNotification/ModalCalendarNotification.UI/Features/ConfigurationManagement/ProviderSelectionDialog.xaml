<Window
  x:Class="ModalCalendarNotification.UI.Features.ConfigurationManagement.ProviderSelectionDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Select Provider"
  Width="360"
  Height="260"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="Provider" FontWeight="SemiBold" />
    <ComboBox
      Grid.Row="1"
      Margin="0,8,0,12"
      ItemsSource="{Binding AvailableProviders}"
      SelectedItem="{Binding SelectedProvider}"
    />

    <TextBlock Grid.Row="2" Text="Account Label" FontWeight="SemiBold" />
    <TextBox
      Grid.Row="3"
      Margin="0,8,0,12"
      Text="{Binding AccountLabel, UpdateSourceTrigger=PropertyChanged}"
    />

    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,0,0,12" TextWrapping="Wrap" />

    <Button
      Grid.Row="5"
      HorizontalAlignment="Right"
      Width="90"
      Content="Connect"
      Command="{Binding ConfirmCommand}"
    />
  </Grid>
</Window>
