<Window
  x:Class="ModalCalendarNotification.UI.Features.StartupRecovery.StartupMissedEventsModal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Missed Events"
  Width="520"
  Height="360"
  WindowStartupLocation="CenterScreen"
  Topmost="True"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock
      Text="Events missed while the app was offline"
      FontWeight="SemiBold"
      FontSize="16"
      Margin="0,0,0,12"
    />

    <ListView Grid.Row="1" ItemsSource="{Binding MissedEvents}">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="220" />
          <GridViewColumn Header="Start" DisplayMemberBinding="{Binding StartUtc}" Width="220" />
        </GridView>
      </ListView.View>
    </ListView>

    <Button
      Grid.Row="2"
      Width="90"
      HorizontalAlignment="Right"
      Margin="0,12,0,0"
      Content="Close"
      Command="{Binding CloseCommand}"
    />
  </Grid>
</Window>
