<Window
  x:Class="ModalCalendarNotification.UI.Features.CalendarSelection.CalendarListDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Calendar Selection"
  Width="500"
  Height="360"
  WindowStartupLocation="CenterOwner"
  ResizeMode="NoResize"
>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Select which calendars to monitor:" FontWeight="SemiBold" Margin="0,0,0,8" />

    <ListView Grid.Row="1" ItemsSource="{Binding Items}">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Selected" Width="80">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <CheckBox
                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                  HorizontalAlignment="Center"
                />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn
            Header="Provider"
            DisplayMemberBinding="{Binding ProviderName}"
            Width="140"
          />
          <GridViewColumn
            Header="Calendar"
            DisplayMemberBinding="{Binding DisplayName}"
            Width="220"
          />
        </GridView>
      </ListView.View>
    </ListView>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Width="90" Margin="0,0,8,0" Content="Apply" Command="{Binding SaveCommand}" />
      <Button Width="90" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
